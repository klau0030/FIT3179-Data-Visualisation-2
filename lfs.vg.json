{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Split view: participation and unemployment stacked for clarity",
  "params": [
    { "name": "state_filter", "value": "All", "bind": { "input": "select", "name": "State: ", "options": ["All","Johor","Kedah","Kelantan","Melaka","Negeri Sembilan","Pahang","Perak","Perlis","Pulau Pinang","Sabah","Sarawak","Selangor","Terengganu","W.P. Kuala Lumpur","W.P. Labuan","W.P. Putrajaya"] } },
    { "name": "time_window", "value": "All", "bind": { "input": "select", "name": "Time: ", "options": ["All","Last 2 Years","2024"] } }
  ],
  "vconcat": [
    {
      "title": "Participation rate (%)",
      "width": 720,
      "height": 220,
      "data": { "url": "https://raw.githubusercontent.com/klau0030/FIT3179-Data-Visualisation-2/refs/heads/main/lfs_qtr_state.csv", "format": { "type": "csv" } },
      "transform": [
        { "filter": "(time_window == 'All') || (time_window == '2024' && year(datum.date) == 2024) || (time_window == 'Last 2 Years' && datum.date >= datetime(2023,1,1))" },
        { "filter": "state_filter == 'All' || datum.state == state_filter" }
      ],
      "mark": { "type": "line", "point": true, "interpolate": "monotone" },
      "encoding": {
        "x": { "field": "date", "type": "temporal", "axis": { "title": "Quarter" } },
        "y": { "field": "p_rate", "type": "quantitative", "scale": { "domain": [0, 80] }, "axis": { "title": "Participation rate (%)", "grid": true } },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "range": [
              "#1f77b4","#aec7e8","#ff7f0e","#ffbb78","#9467bd","#c5b0d5",
              "#8c564b","#c49c94","#e377c2","#f7b6d2","#7f7f7f","#c7c7c7",
              "#bcbd22","#dbdb8d","#17becf","#9edae5","#393b79","#5254a3",
              "#637939","#8ca252"
            ]
          },
          "legend": { "title": "State" }
        },
        "tooltip": [ { "field": "state", "type": "nominal" }, { "field": "date", "type": "temporal", "title": "Quarter" }, { "field": "p_rate", "type": "quantitative", "title": "Participation rate (%)" } ]
      }
    },
    {
      "title": "Unemployment rate (%)",
      "width": 720,
      "height": 180,
      "data": { "url": "https://raw.githubusercontent.com/klau0030/FIT3179-Data-Visualisation-2/refs/heads/main/lfs_qtr_state.csv", "format": { "type": "csv" } },
      "transform": [
        { "filter": "(time_window == 'All') || (time_window == '2024' && year(datum.date) == 2024) || (time_window == 'Last 2 Years' && datum.date >= datetime(2023,1,1))" },
        { "filter": "state_filter == 'All' || datum.state == state_filter" }
      ],
      "mark": { "type": "line", "point": true, "interpolate": "monotone", "strokeDash": [4,2] },
      "encoding": {
        "x": { "field": "date", "type": "temporal", "axis": { "title": "Quarter" } },
        "y": { "field": "u_rate", "type": "quantitative", "scale": { "domain": [0, 10] }, "axis": { "title": "Unemployment rate (%)", "grid": true } },
  "color": { "field": "state", "type": "nominal", "scale": { "scheme": "category20b" }, "legend": null },
        "tooltip": [ { "field": "state", "type": "nominal" }, { "field": "date", "type": "temporal", "title": "Quarter" }, { "field": "u_rate", "type": "quantitative", "title": "Unemployment rate (%)" } ]
      }
    }
  ],
  "resolve": { "scale": { "color": "shared" } },
  "config": { "background": "#ffffff", "axis": { "labelFont": "Helvetica, Arial, sans-serif", "titleFont": "Helvetica, Arial, sans-serif" }, "legend": { "labelFont": "Helvetica, Arial, sans-serif" }, "title": { "font": "Times New Roman, Georgia, serif", "fontSize": 16 } }
}
